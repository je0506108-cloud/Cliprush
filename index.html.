
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ClipRush - AI Clip Creator</title>
<style>
body{margin:0;padding:20px;background:#10111b;color:white;font-family:Arial,sans-serif}
.card{max-width:520px;margin:25px auto;padding:22px;background:#1d2030;border-radius:18px}
h1{color:#8b7cff;text-align:center}
p{color:#c8cada;line-height:1.5}
label{display:block;margin-top:16px}
input,button{box-sizing:border-box;width:100%;padding:13px;margin-top:9px;border-radius:9px;font-size:16px}
input{background:#10111b;color:white;border:1px solid #454963}
button{background:#7565ff;color:white;border:0;font-weight:bold}
button:disabled{opacity:.5}
#status{overflow-wrap:anywhere;margin-top:18px}
a{color:#a99fff}
hr{border:1px solid #454963;margin:25px 0}
</style>
</head>
<body>
<div class="card">
<h1>ClipRush ⚡</h1>
<p style="text-align:center">Turn your videos into shareable clips.</p>

<h3>1. Upload a video</h3>
<label for="video">Choose a video file</label>
<input id="video" type="file" accept="video/*">
<label for="start">Clip start time (seconds)</label>
<input id="start" type="number" min="0" value="0">
<label for="duration">Clip length (seconds)</label>
<input id="duration" type="number" min="1" max="180" value="30">
<button id="uploadBtn" onclick="uploadVideo()">Upload and create clip</button>

<hr>
<h3>2. Check a video link</h3>
<input id="videoUrl" type="url" placeholder="Paste a YouTube or other video link">
<button onclick="checkVideo()">Check video link</button>

<p id="status">Ready when you are.</p>
<div id="download"></div>
</div>

<script>
const API='https://cliprush-api.onrender.com';

async function uploadVideo(){
 const file=document.getElementById('video').files[0];
 const status=document.getElementById('status');
 const button=document.getElementById('uploadBtn');
 const start=Number(document.getElementById('start').value);
 const duration=Number(document.getElementById('duration').value);
 document.getElementById('download').innerHTML='';

 if(!file){status.textContent='Please choose a video first.';return;}
 if(!file.type.startsWith('video/')){status.textContent='Please choose a video file.';return;}
 if(file.size>500*1024*1024){status.textContent='Video must be 500 MB or smaller.';return;}
 if(!Number.isFinite(start)||start<0||!Number.isFinite(duration)||duration<1||duration>180){
 status.textContent='Use a start time of 0 or more and a clip length from 1 to 180 seconds.';return;
 }

 button.disabled=true;
 status.textContent='Uploading video...';
 try{
 const form=new FormData();
 form.append('file',file);
 const upload=await fetch(API+'/v1/uploads',{method:'POST',body:form});
 const uploaded=await upload.json();
 if(!upload.ok)throw new Error(uploaded.detail||'Upload failed.');

 const jobId=uploaded.job_id||uploaded.id;
 if(!jobId)throw new Error('Upload response did not include a job ID.');

 status.textContent='Video uploaded. Creating your clip...';
 const response=await fetch(API+'/v1/jobs/'+encodeURIComponent(jobId)+'/process?start_seconds='+start+'&duration_seconds='+duration,{method:'POST'});
 const result=await response.json();
 if(!response.ok)throw new Error(result.detail||'Clip processing failed.');

 status.textContent='Clip processing request completed.';
 const downloadResponse=await fetch(API+'/v1/jobs/'+encodeURIComponent(jobId)+'/download');
 if(downloadResponse.ok){
 const blob=await downloadResponse.blob();
 const url=URL.createObjectURL(blob);
 document.getElementById('download').innerHTML='<a id="saveClip" download="cliprush-clip.mp4">Download your clip</a>';
 document.getElementById('saveClip').href=url;
 }else{
 status.textContent+=' Check the job result before downloading.';
 }
 }catch(error){
 status.textContent='Error: '+error.message;
 }finally{
 button.disabled=false;
 }
}

async function checkVideo(){
 const url=document.getElementById('videoUrl').value.trim();
 const status=document.getElementById('status');
 if(!url){status.textContent='Please paste a video link first.';return;}
 try{
 new URL(url);
 status.textContent='Checking link...';
 const response=await fetch(API+'/v1/links/check',{
 method:'POST',
 headers:{'Content-Type':'application/json'},
 body:JSON.stringify({url:url})
 });
 const data=await response.json();
 status.textContent=data.message||JSON.stringify(data);
 }catch(error){
 status.textContent='Could not check the link. Please try again.';
 }
}
</script>
</body>
</html>
